<!DOCTYPE html>
<html lang="en-NZ">
    <head>
        <link rel="stylesheet" href="/static/css/style.css">
        <link rel="icon" href="/favicon.ico" type="image/x-icon">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta charset="UTF-8">
    </head>

    <body>
        <main class="font">
            <div class="flex vcentered">
                <div class="flex card column centered gap-1">
                    <span class="bold">Login</span>

                    <form class="flex column gap-1 centered" action="/api/login" method="POST" onsubmit="checkLogin(event)">
                        <%- renderUtils.textField('email', 'Email') %>
                        <%- renderUtils.textField('password', 'Password', 'password') %>

                        <input type="submit" class="submit" id="login" value="Login">
                        <span style="display: none;" id="inc-login">Incorrect Login</span>
                        <a class="white bold no-decorations" href="/create_account">No account, create one.</a>
                    </form>
                </div>
            </div>
        </main>

        <script>
            async function checkLogin(event) {
                event.preventDefault();

                document.getElementById("login").classList.add("loading");

                const email = document.getElementById("email").value;
                const password = document.getElementById("password").value;

                const data = {
                    email: email,
                    password: password
                }

                const request = await fetch(`/api/valid_login`, {
                    method: "POST",
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                if (request.status === 200)
                    event.target.submit();
                else {
                    document.getElementById("inc-login").style.display = "block";
                    document.getElementById("login-button").classList.remove("loading");
                }
            }
        </script>
    </body>
</html>