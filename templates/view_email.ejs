<div class="flex card grow inbox scrollable column no-padding gap-2 background-gradient">
    <div class="email-nav flex row gap-2 vcentered unselectable">
        <img src="/static/assets/arrow_back_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.svg" id="back"></img>
        <img src="/static/assets/delete_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.svg" onclick="deleteEmail()"></img>

        <span id="email-subject">Loading...</span>
        <span>-</span>

        <div class="flex row gap-1 unselectable" style="align-items: flex-end">
            <span id="email-name" class="flex row gap-1"></span>
            <span id="email-email" style="color: rgb(215, 215, 215); font-size: 0.85rem;"></span>
        </div>
    </div>

    <div class="email-content" id="email"></div>

    <div class="flex row gap-4" style="margin-left: 20px; margin-top: 20px;">
        <button class="compose" onclick="replyEmail()">Reply</button>
        <button class="compose">Foward</button>
    </div>
</div>

<script src="/static/js/view_email.js"></script>