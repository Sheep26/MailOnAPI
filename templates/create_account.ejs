<!DOCTYPE html>
<html lang="en-NZ">
    <head>
        <link rel="stylesheet" href="/static/css/style.css">
        <link rel="icon" href="/favicon.ico" type="image/x-icon">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta charset="UTF-8">
    </head>

    <body>
        <main class="font">
            <div class="flex vcentered">
                <div class="flex card column centered gap-1">
                    <span class="bold">Create Account</span>

                    <form class="flex column gap-1 centered" action="/api/create_account" method="POST" onsubmit="checkLogin(event)">
                        <%- renderUtils.textField('email', 'Email') %>
                        <%- renderUtils.textField('name', 'Username') %>
                        <%- renderUtils.textField('password', 'Password', 'password') %>
                        <%- renderUtils.textField('password2', 'Password again', 'password') %>

                        <input type="submit" class="submit" id="login" value="Create Account">
                        <span style="display: none;" id="inc-login">Passwords are not the same</span>
                        <span style="display: none;" id="inc-domain">Domain is not wchouses.co.nz</span>
                    </form>
                </div>
            </div>
        </main>

        <script>
            async function checkLogin(event) {
                event.preventDefault();

                document.getElementById("login").classList.add("loading");

                const email = document.getElementById("email").value;
                const password = document.getElementById("password").value;
                const password2 = document.getElementById("password2").value;

                if (!email.endsWith('@wchouses.co.nz')) {
                    document.getElementById("inc-domain").style.display = "block";

                    return;
                }

                if (password != password2) {
                    document.getElementById("inc-login").style.display = "block";

                    return;
                }

                event.target.submit();
            }
        </script>
    </body>
</html>