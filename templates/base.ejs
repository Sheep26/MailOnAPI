<!DOCTYPE html>
<html lang="en-NZ">
    <head>
        <link rel="stylesheet" href="/static/css/style.css">
        <link rel="icon" href="/favicon.ico" type="image/x-icon">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta charset="UTF-8">
    </head>

    <body>
        <main class="font" id="main">
            <div class="flex row gap-2 grow">
                <div class="card sidebar flex column gap-2 background-gradient">
                    <div class="flex flex-end">
                        <button class="compose" onclick="openCompose()">Compose</button>
                    </div>

                    <div class="flex column " id="mail_boxes">
                        <div class="flex row gap-1 space-between vcentered">
                            <input placeholder="New Mailbox" id="new_mailbox">
                            <img src="/static/assets/add_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.svg" onclick="newMailBox()" width="30px">
                        </div>
                    </div>
                </div>

                <%- include(content) %>
            </div>
        </main>

        <script src="/static/js/base.js"></script>
    </body>
</html>